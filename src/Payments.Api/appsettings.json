{
  "ConnectionStrings": {
    // Small pool and server-side timeouts in the connection string itself (experiments 3 and 4):
    // ALTER DATABASE settings would not reach connections already open in the pool.
    // No password here: Npgsql reads it from %APPDATA%\postgresql\pgpass.conf, like psql does (README, step 2).
    "Payments": "Host=localhost;Port=5433;Database=payments;Username=postgres;Maximum Pool Size=16;Options=-c idle_in_transaction_session_timeout=15s -c statement_timeout=5s",
    "Kafka": "127.0.0.1:9092"
  },
  "Fees": {
    "Bps": 200
  },
  "Acquirer": {
    "LatencyMs": 0,
    "DeclineRatePercent": 2,
    "Mode": "Http",
    "BaseAddress": "http://localhost:5300/"
  },
  "Outbox": {
    "BatchSize": 500,
    "IdleDelayMs": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
