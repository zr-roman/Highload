{
  "ConnectionStrings": {
    // Small pool and server-side timeouts in the connection string itself (experiments 3 and 4):
    // ALTER DATABASE settings would not reach connections already open in the pool.
    // No password here: Npgsql reads it from %APPDATA%\postgresql\pgpass.conf, like psql does (README, step 2).
    "Payments": "Host=localhost;Port=5433;Database=payments;Username=postgres;Maximum Pool Size=16;Options=-c idle_in_transaction_session_timeout=15s -c statement_timeout=5s",
    "Kafka": "127.0.0.1:9092",
    // Redis holds only what can be lost: rate limits, notifications. Short timeouts: a slow Redis
    // must not hold a payment longer than the payment itself takes; on timeout the limit is skipped.
    "Redis": "127.0.0.1:6379,connectTimeout=2000,syncTimeout=100,asyncTimeout=100"
  },
  "Fees": {
    "Bps": 200
  },
  "Acquirer": {
    "LatencyMs": 0,
    "DeclineRatePercent": 2,
    "Mode": "Http",
    "BaseAddress": "http://localhost:5300/",
    // Bank calls answer in 50–70 ms: the defaults (10 s per attempt, 30 s in total) are made for slow dependencies.
    "Resilience": {
      "AttemptTimeout": { "Timeout": "00:00:00.300" },
      "Retry": {
        "MaxRetryAttempts": 2,
        "Delay": "00:00:00.050"
      },
      "TotalRequestTimeout": { "Timeout": "00:00:02" },
      "CircuitBreaker": {
        "FailureRatio": 0.5,
        "MinimumThroughput": 20,
        "SamplingDuration": "00:00:10",
        "BreakDuration": "00:00:05"
      }
    }
  },
  "Recovery": {
    "StaleAfter": "00:00:30",
    "Interval": "00:00:10",
    "BatchSize": 100,
    "MaxParallelism": 8
  },
  "Outbox": {
    "BatchSize": 500,
    "IdleDelayMs": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
