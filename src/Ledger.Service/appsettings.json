{
  "ConnectionStrings": {
    // One consumer writes one batch at a time, so a small pool is enough.
    // No password here: Npgsql reads it from %APPDATA%\postgresql\pgpass.conf, like psql does (README, step 2).
    // Minimum Pool Size = Maximum, as in Payments.Api: Npgsql does not close idle connections every 5 minutes
    // only to open them again under load.
    "Ledger": "Host=localhost;Port=5433;Database=ledger;Username=postgres;Maximum Pool Size=8;Minimum Pool Size=8;Options=-c idle_in_transaction_session_timeout=15s -c statement_timeout=10s",
    "Kafka": "127.0.0.1:9092"
  },
  "Consumer": {
    "GroupId": "ledger",
    "BatchSize": 500,
    "MaxBatchDelayMs": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
