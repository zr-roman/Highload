{
  "ConnectionStrings": {
    // MongoDB of docker compose: one node, no user, on 127.0.0.1 alone (README, step 1). A server not found in 5 s,
    // or one that does not answer in 10, is an error for the caller, not a wait of 30 s or for ever, the defaults:
    // the consumer writes its batch again, and it must not hang on a MongoDB that hangs.
    "History": "mongodb://127.0.0.1:27017/?serverSelectionTimeoutMS=5000&socketTimeoutMS=10000",
    "Kafka": "127.0.0.1:9092"
  },
  "History": {
    "Database": "history"
  },
  "Consumer": {
    "GroupId": "history",
    "BatchSize": 500,
    "MaxBatchDelayMs": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
