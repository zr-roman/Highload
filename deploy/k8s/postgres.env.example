# Copy to postgres.env (not in git) and put the password of the postgres user in place of CHANGE_ME.
# Each line is KEY=VALUE up to the end of the line: no quotes, the value may contain = and ;.
# The settings after the password are the same as in the services' appsettings.json.
ConnectionStrings__Payments=Host=host.docker.internal;Port=5433;Database=payments;Username=postgres;Password=CHANGE_ME;Maximum Pool Size=16;Minimum Pool Size=16;Options=-c idle_in_transaction_session_timeout=15s -c statement_timeout=5s
ConnectionStrings__Ledger=Host=host.docker.internal;Port=5433;Database=ledger;Username=postgres;Password=CHANGE_ME;Maximum Pool Size=8;Minimum Pool Size=8;Options=-c idle_in_transaction_session_timeout=15s -c statement_timeout=10s
