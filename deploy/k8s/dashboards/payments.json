    {
      "type": "timeseries",
      "title": "Проведено → отправлено из outbox → записано в журнал",
      "description": "Три скорости на одном графике. Отправлено меньше проведённого — растёт outbox; записано меньше отправленного — растёт lag Ledger. После нагрузки отстающая линия идёт выше: асинхронная часть догоняет.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(payments_captured_total[$__rate_interval]))",
          "legendFormat": "проведено",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(payments_outbox_published_total[$__rate_interval]))",
          "legendFormat": "отправлено из outbox в Kafka",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ledger_payments_applied_total[$__rate_interval]))",
          "legendFormat": "записано в журнал",
          "range": true
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      }
